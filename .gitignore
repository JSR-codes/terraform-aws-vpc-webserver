# Local .terraform directories
**/.terraform/*

# Terraform state files (may contain sensitive data)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files that may contain sensitive data
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Lock file (optional to commit - commit it for reproducibility)
# .terraform.lock.hcl
